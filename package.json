{
  "name": "utterlog-bun",
  "version": "1.6.0",
  "packageManager": "bun@1.4.5",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./app/start/src/web/*",
    "@shared/*": "./app/shared/*",
    "@backend/*": "./app/start/src/backend/*"
  },
  "workspaces": [
    "app/admin",
    "app/start"
  ],
  "scripts": {
    "dev": "bun run app/start/src/backend/index.ts",
    "start": "NODE_ENV=production bun run app/start/src/backend/index.ts",
    "test:server": "JWT_SECRET=test-secret-for-server-tests bun test app/start/test",
    "test:integration": "UTTERLOG_INTEGRATION_DB=1 JWT_SECRET=test-secret-for-server-tests bun test app/start/test/comments-service.integration.test.ts",
    "audit:api": "bun scripts/audit-api-coverage.ts",
    "smoke:api": "bash scripts/api-smoke-test.sh",
    "build:web": "cd app/start && bun run sync:themes",
    "build:admin": "cd app/admin && bun run build",
    "build": "bun run build:admin && bun run start:build",
    "check": "cd app/start && bun run check",
    "verify": "bun run check && bun run build && bun run test:server && bun run audit:api",
    "start:dev": "cd app/start && bun run dev",
    "start:build": "cd app/start && bun run build"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.1",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
