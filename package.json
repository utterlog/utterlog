{
  "name": "utterlog-bun",
  "version": "1.3.8",
  "packageManager": "bun@1.4.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./app/web/*",
    "@shared/*": "./app/shared/*"
  },
  "workspaces": [
    "app/web",
    "app/admin",
    "app/start"
  ],
  "scripts": {
    "dev": "bun run app/server/src/index.ts",
    "server:dev": "bun run app/server/src/index.ts",
    "server:check": "bunx tsc -p app/server/tsconfig.json --noEmit",
    "test:server": "JWT_SECRET=test-secret-for-server-tests bun test app/server/test",
    "test:integration": "UTTERLOG_INTEGRATION_DB=1 JWT_SECRET=test-secret-for-server-tests bun test app/server/test/comments-service.integration.test.ts",
    "audit:api": "bun scripts/audit-api-coverage.ts",
    "build:web": "cd app/web && bun run sync:themes",
    "build:admin": "cd app/admin && bun run build",
    "start:dev": "cd app/start && bun run dev",
    "start:build": "cd app/start && bun run build",
    "start:check": "cd app/start && bun run check"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "jose": "^6.2.3",
    "nodemailer": "^9.0.1",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2"
  }
}
