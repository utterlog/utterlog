# ============================================================
# Utterlog Bun app — single application container
# ------------------------------------------------------------
# Runtime responsibilities:
#   - Bun 1.4 security/static gateway on :8080
#   - Admin TanStack Start SPA served from app/admin/dist/client
#   - TanStack Start SSR and Server Routes
# ============================================================

FROM --platform=linux/amd64 oven/bun:canary@sha256:f2c7cd1cc7909c1fd57cc4b2fba4af0b24df7eb9709810dbfdae5adf52f34fab AS deps
WORKDIR /app
COPY package.json bun.lock bunfig.toml tsconfig.json ./
COPY app/web/package.json ./app/web/package.json
COPY app/admin/package.json ./app/admin/package.json
COPY app/start/package.json ./app/start/package.json
RUN bun install --frozen-lockfile

FROM deps AS admin-builder
WORKDIR /app
COPY app/shared ./app/shared
COPY app/admin/ ./app/admin/
WORKDIR /app/app/admin
# Reuse a host-prebuilt dist when present (see .dockerignore) — the SPA
# prerender's self-serving server fails under emulated docker builds.
# Native builds have no prebuilt dist and build here as usual.
RUN if [ -f dist/client/index.html ]; then echo "==> using host-prebuilt admin dist"; else bun run build; fi

FROM deps AS start-builder
WORKDIR /app
COPY app/shared ./app/shared
COPY app/web ./app/web
COPY app/start ./app/start
WORKDIR /app/app/start
RUN bun run build

FROM --platform=linux/amd64 oven/bun:canary@sha256:f2c7cd1cc7909c1fd57cc4b2fba4af0b24df7eb9709810dbfdae5adf52f34fab AS runtime
WORKDIR /app
ARG GIT_SHA=unknown
ARG GIT_BRANCH=unknown
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.source="https://github.com/utterlog/utterlog"
RUN apt-get update \
  && apt-get install -y --no-install-recommends wget ca-certificates \
  && install -d /usr/share/postgresql-common/pgdg \
  && wget -qO /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
  && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt trixie-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends postgresql-client-18 unzip \
  && apt-get purge -y --auto-remove wget \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV PORT=8080

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/app/web/node_modules ./app/web/node_modules
COPY --from=deps /app/app/start/node_modules ./app/start/node_modules
COPY package.json bun.lock bunfig.toml tsconfig.json ./
COPY app/web ./app/web
COPY app/start ./app/start
COPY app/shared ./app/shared
COPY --from=admin-builder /app/app/admin/dist/client ./app/admin/dist/client
COPY --from=start-builder /app/app/start/dist ./app/start/dist
COPY content ./content

RUN mkdir -p uploads content/themes content/plugins \
  && bun app/web/scripts/sync-theme-styles.mjs

RUN printf '%s\n' "$GIT_SHA" > /app/.deploy-revision \
  && printf '%s\n' "$GIT_BRANCH" > /app/.deploy-branch

EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
  CMD bun -e "const r=await fetch('http://127.0.0.1:8080/api/v1/install/status').catch(()=>null); process.exit(r&&r.ok?0:1)"

CMD ["bun", "run", "app/start/src/backend/index.ts"]
