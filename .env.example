# ============================================================
# Utterlog 环境变量模板
# ------------------------------------------------------------
# 复制此文件为 .env 并按需修改：  cp .env.example .env
# 裸机 Bun 部署会读取该文件；scripts/deploy.sh 会补齐随机密钥与运行目录。
# ============================================================

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=utterlog
DB_USER=utterlog
# 留空 — deploy.sh / install.sh 会生成随机密码写入此处
DB_PASSWORD=
DB_PREFIX=ul_

# ---- API ----
HOST=127.0.0.1
PORT=9260
APP_URL=http://localhost:9260
# 生产公网部署时可设为 true，强制 APP_URL 不能是 localhost/127.0.0.1。
REQUIRE_PUBLIC_APP_URL=false
# 默认只允许 APP_URL 同源访问 API；需要分离前后端域名时填允许的 Origin，多个用逗号分隔。
# CORS_ORIGIN=https://blog.example.com,https://admin.example.com
# 留空 — deploy.sh / install.sh 会生成随机密钥
JWT_SECRET=

# ---- 裸机部署 / systemd ----
UTTERLOG_INSTALL_DIR=/opt/utterlog
UTTERLOG_SERVICE=utterlog-app
UTTERLOG_SERVICE_USER=utterlog
UTTERLOG_UPDATE_PATH_UNIT=utterlog-update.path
UTTERLOG_UPDATE_REQUEST_FILE=/opt/utterlog/.runtime/update.request

# ---- 文件存储（local 或 s3）----
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# S3/R2 配置（STORAGE_DRIVER=s3 时生效）
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# ---- 源码/资源路径（目录合并迁移用；默认不需要修改）----
# SERVER_ASSETS_DIR=app/start/assets
# SCHEMA_FILE=app/start/assets/schema.sql
# INSTALLER_FAVICON=app/start/assets/installer/favicon.svg
# BUILTIN_LOCALE_DIR=app/start/assets/i18n/locales
# BUILTIN_THEMES_DIR=app/start/src/web/themes
# BUILTIN_PLUGINS_DIR=app/start/src/web/plugins
# BUILTIN_PUBLIC_THEMES_DIR=app/start/src/web/public/themes
# ADMIN_DIST_DIR=app/admin/dist/client
# SERVER_PUBLIC_DIR=app/start/assets/public
