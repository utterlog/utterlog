{
  "name": "utterlog-start",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && bun --bun app/start/node_modules/vite/bin/vite.js app/start --config app/start/vite.config.ts --host 127.0.0.1 --port 3010",
    "build": "cd ../.. && bun --bun app/start/node_modules/vite/bin/vite.js build app/start --config app/start/vite.config.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
