{
  "name": "utterlog-start",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:themes": "bun src/web/scripts/sync-theme-styles.mjs",
    "predev": "bun src/web/scripts/sync-theme-styles.mjs",
    "prebuild": "bun src/web/scripts/sync-theme-styles.mjs",
    "dev": "cd ../.. && bun --bun app/start/node_modules/vite/bin/vite.js app/start --config app/start/vite.config.ts --host 127.0.0.1 --port 3010",
    "build": "cd ../.. && bun --bun app/start/node_modules/vite/bin/vite.js build app/start --config app/start/vite.config.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "axios": "^1.21.1",
    "mapbox-gl": "^3.35.2",
    "motion": "^14.14.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^10.1.0",
    "rehype-prism-plus": "^2.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
