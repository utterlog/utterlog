{
  "name": "utterlog-start",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:themes": "node src/web/scripts/sync-theme-styles.mjs",
    "predev": "node src/web/scripts/sync-theme-styles.mjs",
    "prebuild": "node src/web/scripts/sync-theme-styles.mjs",
    "dev": "cd ../.. && bun --bun app/start/node_modules/vite/bin/vite.js app/start --config app/start/vite.config.ts --host 127.0.0.1 --port 3010",
    "build": "cd ../.. && bun --bun app/start/node_modules/vite/bin/vite.js build app/start --config app/start/vite.config.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "axios": "^1.18.1",
    "framer-motion": "^12.42.0",
    "mapbox-gl": "^3.25.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "rehype-prism-plus": "^2.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
